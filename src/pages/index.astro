---
import Layout from '../layouts/Layout.astro'
import Studio from '../components/Studio.tsx'
---

<Layout>
  <section class="hero">
    <p class="eyebrow">invoice.oriz.in · the ledger</p>
    <h1 class="hero__title">Invoice generator</h1>
    <p class="hero__lede">
      Bill a client in seconds. Line items with live totals, GST-aware tax
      (CGST/SGST or IGST), any currency, your logo, and clean print-to-PDF —
      with the grand total spelled out in words. Everything stays in your
      browser: nothing is uploaded, no signup.
    </p>
    <ul class="hero__spec">
      <li>auto totals + tax</li>
      <li>INR / GST + 8 currencies</li>
      <li>print → PDF</li>
      <li>autosaves locally</li>
    </ul>
  </section>

  <Studio client:load />
</Layout>

<style>
  .hero {
    padding: 1rem 0 0.5rem;
    max-width: 48rem;
  }
  .hero__title {
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    margin: 0.5rem 0 0.9rem;
  }
  .hero__lede {
    font-size: 1.08rem;
    color: var(--oz-fg);
    margin: 0 0 1.1rem;
    max-width: 42rem;
  }
  .hero__spec {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    padding: 0;
    margin: 0;
    font-family: var(--oz-font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.05em;
    color: var(--lg-label);
  }
  .hero__spec li {
    position: relative;
    padding-left: 1rem;
  }
  .hero__spec li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 7px;
    height: 7px;
    background: var(--lg-gold);
    transform: rotate(45deg);
  }
</style>
