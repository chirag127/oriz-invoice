---
import '@chirag127/oz-tokens-base'
import '@chirag127/oz-chrome/styles.css'
import '@fontsource-variable/spline-sans'
import '@fontsource-variable/spline-sans-mono'
import '../styles/theme.css'
import '../styles/studio.css'
import OzToolShell from '@chirag127/oz-chrome/components/OzToolShell.astro'

interface Props {
  title?: string
  description?: string
}
const {
  title = 'oriz Invoice — free GST invoice generator, no signup',
  description = 'Free online GST invoice generator: line items, auto totals + CGST/SGST/IGST, any currency, your logo, print to PDF. 100% in your browser, no signup.',
} = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site).href
const ogImage = new URL('/screenshots/desktop.png', Astro.site).href
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'oriz Invoice',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  url: 'https://invoice.oriz.in',
  description,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  featureList: [
    'GST-aware tax (CGST/SGST or IGST)',
    'Multi-currency invoices',
    'Auto totals + amount in words',
    'Logo upload',
    'Print to PDF',
    '100% client-side, no signup',
  ],
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <script src="/registerSW.js" defer></script>
    <meta property="og:site_name" content="oriz Invoice" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body>
    <OzToolShell site="invoice" title="invoice generator" themeColor="#0f5132">
      <slot />
      <Fragment slot="footer">
        <a href="https://github.com/chirag127/oriz-invoice">source</a>
        <span>100% client-side · no upload · no signup</span>
      </Fragment>
    </OzToolShell>
  </body>
</html>
